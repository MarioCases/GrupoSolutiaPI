<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFF8FAFC"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="16dp"
        android:contentDescription="Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Portal Grupo Solutia"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FF2D3748"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicia sesión para continuar"
        android:textSize="14sp"
        android:textColor="#FF9CA3AF"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCertificate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Acceder con Certificado Digital"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        app:icon="@drawable/ic_certificate"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        app:iconPadding="12dp"
        app:cornerRadius="12dp"
        android:backgroundTint="#FF4A5568"
        style="@style/Widget.Material3.Button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:text="o"
        android:textAlignment="center"
        android:textColor="#FF9CA3AF"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Acceder con Google"
        android:textSize="15sp"
        android:textColor="#FF2D3748"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:cornerRadius="12dp"
        android:backgroundTint="#FFFFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#FFE2E8F0"
        app:rippleColor="#11000000"
        style="@style/Widget.Material3.Button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Entorno de pruebas · Todos los accesos permitidos"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="#FFCBD5E1" />

</LinearLayout>
