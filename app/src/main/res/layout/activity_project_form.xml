<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8FAFC"
    tools:context=".ProjectFormActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarForm"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="Nuevo Proyecto"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Project Name -->
            <TextView style="@style/FormLabel" android:text="Nombre del proyecto" />
            <EditText
                android:id="@+id/formName"
                style="@style/FormInput"
                android:hint="ej. Gestor de Incidencias"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- Description -->
            <TextView style="@style/FormLabel" android:text="Descripción" android:layout_marginTop="16dp" />
            <EditText
                android:id="@+id/formDescription"
                style="@style/FormInput"
                android:hint="Descripción del proyecto"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top"
                android:importantForAutofill="no" />

            <!-- Status -->
            <TextView style="@style/FormLabel" android:text="Estado" android:layout_marginTop="16dp" />
            <RadioGroup
                android:id="@+id/formStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/statusProduction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Producción"
                    android:textSize="13sp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/statusDevelopment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="En Desarrollo"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/statusMaintenance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mantenimiento"
                    android:textSize="13sp" />

            </RadioGroup>

            <!-- Technologies -->
            <TextView style="@style/FormLabel" android:text="Tecnologías" android:layout_marginTop="16dp" />
            <EditText
                android:id="@+id/formTechnologies"
                style="@style/FormInput"
                android:hint="ej. React, Node.js, SQL (separadas por coma)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- Department -->
            <TextView style="@style/FormLabel" android:text="Departamento" android:layout_marginTop="16dp" />
            <EditText
                android:id="@+id/formDepartment"
                style="@style/FormInput"
                android:hint="ej. Sistemas"
                android:inputType="text"
                android:importantForAutofill="no" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE2E8F0"
                android:layout_marginVertical="20dp" />

            <!-- Documents section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DOCUMENTOS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF9CA3AF"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddDocument"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ Añadir"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/accent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/documentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- Delete project button (admin only, edit mode) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Eliminar proyecto"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFEE2E2"
                android:textColor="#FFE53E3E"
                android:visibility="gone"
                app:strokeColor="#FFFECACA"
                app:strokeWidth="1dp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Guardar cambios"
                android:textSize="16sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
